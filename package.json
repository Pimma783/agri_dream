{
  "name": "agrimatch",
  "private": true,
  "version": "0.0.0",
  "description": "Agrimatch MVP monorepo (TypeScript API, worker, Next.js dashboard)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "npm run test:db --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run build && npm test",
    "migrate": "npm run migrate --workspace apps/api --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.73.0"
  }
}
