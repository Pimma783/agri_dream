# Fake values only. Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=4000

DATABASE_URL=postgres://agrimatch:local-dev-only-password@127.0.0.1:5433/agrimatch
TEST_DATABASE_URL=postgres://agrimatch:local-dev-only-password@127.0.0.1:5433/agrimatch_test

# Same-origin setup: browser -> Next.js (3000) -> /api/* rewrite -> API (4000)
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://localhost:4000

# Real integrations stay off until the user supplies credentials and verifies them.
ENABLE_REAL_LINE=false
ENABLE_REAL_BEDROCK=false
# Assistant model use: enabled|disabled. Unset = enabled only when ENABLE_REAL_BEDROCK=true.
# AI_MODE=disabled
# Deprecated and unused: images are stored in PostgreSQL. Kept so old .env files still load.
ENABLE_REAL_S3=false
VISION_ENABLED=false

AWS_REGION=ap-southeast-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5
BEDROCK_VISION_MODEL_ID=anthropic.claude-sonnet-5

# Deprecated and unused (no local-filesystem media store)
LOCAL_MEDIA_DIR=./var/media

# Placeholders, not real secrets
SESSION_SECRET=change-me-fake-session-secret
LINE_FARMER_CHANNEL_SECRET=fake
LINE_FARMER_ACCESS_TOKEN=fake
LINE_BALER_CHANNEL_SECRET=fake
LINE_BALER_ACCESS_TOKEN=fake
LINE_FACTORY_CHANNEL_SECRET=fake
LINE_FACTORY_ACCESS_TOKEN=fake
# Lifetime of signed media links, seconds (10-3600)
MEDIA_URL_TTL_SECONDS=300
